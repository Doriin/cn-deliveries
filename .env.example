DATABASE_URL="postgresql://cn:cn_local_pw@localhost:5432/cn_tms"
# Long random string, e.g. `openssl rand -base64 32`
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Path to the Google service account JSON key (Sheets sync)
GOOGLE_SERVICE_ACCOUNT_JSON="./secrets/google-service-account.json"
# Sheets sync interval in minutes
SHEETS_SYNC_MINUTES=2
# Phone printed on labels
COMPANY_PHONE=""
# Where delivery photos and signatures are stored
UPLOAD_DIR="./uploads"
# Public address of this TMS (used in label QR codes), e.g. https://tms.cn-deliveries.com
PUBLIC_URL=""
